{
  "name": "sovely-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Root workspace for Sovely B2C Application",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../sovely-app && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd sovely-app && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd sovely-app && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "strip-comments": "^2.0.1"
  }
}
